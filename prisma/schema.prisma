// AnyArt — shared schema for public app and admin app (copy in demo_anyart_admin)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Idea {
  id                 String   @id @default(cuid())
  rawInput           String
  title              String
  description        String
  creatorFingerprint String
  votes              Int      @default(0)
  status             String   @default("submitted")
  jiraKey            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  voters             Vote[]
}

model Vote {
  id          String   @id @default(cuid())
  ideaId      String
  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([ideaId, fingerprint])
}
